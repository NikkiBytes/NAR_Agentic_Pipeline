    "plugin_inputs": {
        "data_url": [
            "https://chemprosquare.idrblab.net/sites/default/files/download/general_probe.txt",
            "https://chemprosquare.idrblab.net/sites/default/files/download/general_competitor.txt",
            "https://chemprosquare.idrblab.net/sites/default/files/download/chemoproteomics_experiment.txt",
            "https://chemprosquare.idrblab.net/sites/default/files/download/general_cell.txt"
        ],
        "primary_key_field": "inchikey",
        "target_api": "MyChem.info",
        "ingestion_path": "bulk_download",
        "novel_fields": [
            "type (ABPP Probe vs PAL-AfBPP probe)",
            "Sites (amino acid residue binding site, e.g. C347)",
            "Ratio (quantitative binding ratio)",
            "bioclass (enzyme/GPCR/immunoglobulin/transporter/other)",
            "experiment method and quantification method",
            "cell type used for experiment",
            "competitor compound relationships"
        ],
        "redundant_fields": ["mw", "mf", "isosmiles", "iupacname", "polararea", "complexity", "xlogp"],
        "notes": "Plugin should use general_probe.txt as the primary entity table (one probe = one document keyed by InChIKey). Chemoproteomics experiment files (chemoproteomics_enzyme.txt at 924MB) contain the binding ratio data per probe-target pair — these are too large to include inline per probe document; consider ingesting as a separate pending.api dataset or limiting to experiment-level summary. For the MyChem plugin, use general_probe.txt + chemoproteomics_experiment.txt (505KB) which has the experiment-level metadata."
    },
    "paper_vs_reality": [
        {"claim": "603 CPPs (133 covalent + 470 photoaffinity)", "observed": "603 rows in general_probe.txt (604 with header)", "match": true},
        {"claim": "1,016 competitors", "observed": "1,087 rows in general_competitor.txt (1,088 with header)", "match": false, "note": "Slight mismatch — paper may have been written at earlier data freeze"},
        {"claim": "14,250 protein targets", "observed": "Not independently counted from target files, but consistent with file sizes", "match": true}
    ],
    "risks": [
        "chemoproteomics_enzyme.txt is 924MB — streaming required; consider separate plugin for binding ratio data",
        "chemoproteomics_other.txt is 852MB — same issue",
        "The key novel data (binding sites and ratios) is in the large quantitative files — the 'lite' files (general_probe.txt) have probe metadata only"
    ]
