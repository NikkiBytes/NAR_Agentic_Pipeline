{
    "version": "1.0",
    "__metadata__": {
        "name": "RAVAR",
        "description": "A curated repository of rare variant-trait associations, providing gene-level and variant-level rare-variant association evidence (p-value, effect size, testing method) manually curated from 245 publications and mapped to EFO/HPO trait ontology.",
        "license": "CC BY 4.0",
        "license_url": "https://creativecommons.org/licenses/by/4.0/",
        "url": "http://www.ravar.bio",
        "publication": {
            "doi": "10.1093/nar/gkad876",
            "pmid": "37831073",
            "pmc": "PMC10767942"
        }
    },
    "dumper": {
        "data_url": [
            "http://www.ravar.bio/api/download/static/gene_fulltable.txt",
            "http://www.ravar.bio/api/download/static/snp_fulltable.txt"
        ],
        "uncompress": false,
        "release": "version:get_release"
    },
    "uploaders": [
        {
            "name": "gene_associations",
            "parser": "parser:load_gene_data",
            "on_duplicates": "error",
            "mapping": "mapping:get_gene_mapping"
        },
        {
            "name": "variant_associations",
            "parser": "parser:load_variant_data",
            "on_duplicates": "error",
            "mapping": "mapping:get_variant_mapping"
        }
    ]
}
