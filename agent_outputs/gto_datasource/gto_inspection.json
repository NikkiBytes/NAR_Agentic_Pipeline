    "schema": {
        "clinical_basic": {
            "primary_key": "GTOID",
            "fields": {
                "GTOID": {"type": "string", "role": "IDENTIFIER", "example": "GTC0001", "notes": "GTO-specific unique trial ID"},
                "Trial_ID": {"type": "string", "role": "IDENTIFIER", "example": "NCT00001234", "notes": "ClinicalTrials.gov or other registry ID"},
                "Year": {"type": "integer", "role": "NOVEL", "example": 1999, "notes": "Year first submitted"},
                "Phase": {"type": "string", "role": "NOVEL", "example": "Phase1", "notes": "Clinical trial phase"},
                "Status": {"type": "string", "role": "NOVEL", "example": "Completed", "notes": "Recruitment status"},
                "Title": {"type": "string", "role": "NOVEL", "example": "...", "notes": "Trial title"},
                "Major_Therapy_Category": {"type": "string", "role": "NOVEL", "example": "DNA therapy", "notes": "High-level therapy class"},
                "Therapy_Type": {"type": "string", "role": "NOVEL", "example": "Gene transfer", "notes": "Specific therapy type (22 categories)"},
                "Treatment": {"type": "string", "role": "NOVEL", "example": "GBA1 RTV CD34+ cells", "notes": "Gene therapy product"},
                "Altered_Gene": {"type": "string", "role": "IDENTIFIER", "example": "GBA1", "notes": "HGNC gene symbol; key crosswalk field to MyGene.info"},
                "Vector": {"type": "string", "role": "NOVEL", "example": "retrovirus", "notes": "Delivery vector"},
                "Disease_group": {"type": "string", "role": "REDUNDANT", "example": "genetic disease", "notes": "High-level disease class"},
                "Disease": {"type": "string", "role": "IDENTIFIER", "example": "Gaucher's Disease", "notes": "Disease name; crosswalk via indication file to MONDO/DOID"},
                "ex_in_vivo": {"type": "string", "role": "NOVEL", "example": "ex vivo", "notes": "Delivery context"}
            }
        },
        "clinical_detail_additional_fields": [
            "Country", "link", "Location_Approved", "Co_Treatment",
            "Target/Therapeutic_Gene", "Generation", "Construct", "Vector_Type",
            "Transgene/Inserted Gene", "Regulatory_Element", "Viral_Genome_Modification",
            "Vector_Production_Method", "Additional_Feature", "Administration", "Dose",
            "Remark", "HLA", "Donor_Type", "Pts", "Age", "Activation",
            "Lymph_depletion", "Adverse_Reactions", "CR", "PR", "SD", "Outcome",
            "Company-Sponsor/Collab", "Other_IDs", "References", "Ref_Link", "GTDID"
        ],
        "indication_fields": {
            "study_ID": {"role": "IDENTIFIER", "notes": "GTC ID (joins to clinical files)"},
            "trial_ID": {"role": "IDENTIFIER"},
            "disease": {"role": "IDENTIFIER"},
            "doid": {"role": "IDENTIFIER", "example": "DOID:1926", "notes": "Disease Ontology ID"},
            "disease_ID": {"role": "IDENTIFIER", "example": "C0017205", "notes": "UMLS CUI"},
            "xref": {"role": "IDENTIFIER", "notes": "Cross-refs: DO, MESH, NCI, GARD, MONDO, ORDO, SNOMEDCT, UMLS"},
            "synonyms": {"role": "REDUNDANT"},
            "definition": {"role": "REDUNDANT"},
            "disgenet_disease_name": {"role": "REDUNDANT"},
            "disease_type": {"role": "NOVEL"},
            "diseaseclassmsh": {"role": "REDUNDANT"},
            "diseaseclassnamemsh": {"role": "REDUNDANT"},
            "hpoclassid": {"role": "IDENTIFIER"},
            "hpoclassname": {"role": "REDUNDANT"},
            "doclassid": {"role": "IDENTIFIER"},
            "doclassname": {"role": "REDUNDANT"},
            "umlssemantictypeid": {"role": "IDENTIFIER"},
            "umlssemantictypename": {"role": "REDUNDANT"}
        },
        "omics_fields": {
            "GTDID": {"role": "IDENTIFIER", "notes": "GTO omics dataset ID"},
            "Accession": {"role": "IDENTIFIER", "notes": "GEO accession (GSE ID); primary crosswalk to GEO"},
            "Control": {"role": "NOVEL", "notes": "Semicolon-separated control GSM IDs"},
            "Case": {"role": "NOVEL", "notes": "Semicolon-separated case GSM IDs"},
            "Disease_group": {"role": "REDUNDANT"},
            "Disease": {"role": "IDENTIFIER"},
            "Altered_Gene": {"role": "IDENTIFIER", "notes": "HGNC gene symbol"},
            "Target/Therapeutic_Gene": {"role": "IDENTIFIER"},
            "Treatment": {"role": "NOVEL"},
            "Major_Therapy_Category": {"role": "NOVEL"},
            "Therapy_Type": {"role": "NOVEL"},
            "RNA_Information": {"role": "NOVEL"},
            "Ex/In_Vivo": {"role": "NOVEL"},
            "Vector": {"role": "NOVEL"},
            "Organism": {"role": "NOVEL"},
            "Tissue_Celltype": {"role": "NOVEL"},
            "Remark": {"role": "NOVEL"},
            "Strategy": {"role": "NOVEL", "notes": "RNA-seq, Microarray, scRNA-Seq"},
            "Library_Type": {"role": "NOVEL"},
            "Platform": {"role": "IDENTIFIER", "notes": "GPL platform ID"},
            "Reference": {"role": "IDENTIFIER", "notes": "PMID"},
            "Clinical_Trial": {"role": "IDENTIFIER", "notes": "NCT ID"}
        }
