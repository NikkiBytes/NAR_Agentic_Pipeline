    "plugin_inputs": {
        "data_url": [
            "http://www.inbirg.com/gto/download/clinical_data_download",
            "http://www.inbirg.com/gto/download/clinical_basic_download",
            "http://www.inbirg.com/gto/download/indication",
            "http://www.inbirg.com/gto/download/omics_data_datasets"
        ],
        "primary_key_field": "GTOID",
        "primary_key_notes": "GTOID (e.g. GTC0001) is the unique clinical trial record identifier. For a gene-centric BioThings plugin, Altered_Gene (HGNC symbol) could serve as the key if records are grouped by gene. Recommend using GTOID for direct record-level ingestion, with gene and disease as indexed fields.",
        "target_api": "pending.api",
        "ingestion_path": "bulk_download",
        "file_format": "Excel (.xlsx)",
        "recommended_files": [
            "GTO_clinic_data.xlsx (primary: 6333 trial records, full detail)",
            "GTO_indication.xlsx (disease cross-references: DOID/MONDO IDs for normalization)"
        ],
        "novel_fields": [
            "Phase",
            "Status",
            "Major_Therapy_Category",
            "Therapy_Type",
            "Treatment",
            "Vector",
            "Vector_Type",
            "Construct",
            "Generation",
            "Ex/In_Vivo",
            "Donor_Type",
            "Administration",
            "Dose",
            "Lymph_depletion",
            "Adverse_Reactions",
            "CR",
            "PR",
            "SD",
            "Outcome",
            "Company-Sponsor/Collab",
            "Activation",
            "Strategy (RNA-seq/Microarray/scRNA-Seq)",
            "Tissue_Celltype",
            "Organism"
        ],
        "redundant_fields": [
            "Disease_group (high-level grouping, less precise than MONDO)",
            "synonyms (in indication file)",
            "definition (in indication file)",
            "disgenet_disease_name",
            "diseaseclassnamemsh",
            "umlssemantictypename"
        ],
        "identifier_crosswalk_fields": [
            "Altered_Gene -> MyGene.info (HGNC symbol)",
            "Trial_ID -> ClinicalTrials.gov (NCT ID)",
            "doid -> MyDisease.info (Disease Ontology ID)",
            "MONDO ID (in xref) -> MyDisease.info",
            "Accession -> GEO (GSE accession)",
            "Reference -> PubMed (PMID)"
        ],
        "ingestion_notes": "Excel files download without auth. openpyxl can parse them. clinical_data_download has 6333 rows x 46 cols (primary record). indication file joins on study_ID=GTOID and provides DOID/MONDO for disease normalization. Recommend joining clinical + indication at ingest time to produce enriched records. Large expression profile ZIPs (40+ GB) should NOT be ingested — reference by GEO accession only."
    }
}
