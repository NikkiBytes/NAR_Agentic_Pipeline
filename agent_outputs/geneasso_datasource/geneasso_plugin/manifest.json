      "https://www.geneasso.net/api/download/static/DEPICT.download.txt",
      "https://www.geneasso.net/api/download/static/PASCAL.download.txt",
      "https://www.geneasso.net/api/download/static/LDAK-GBAT.download.txt",
      "https://www.geneasso.net/api/download/static/RWAS.download.txt",
      "https://www.geneasso.net/api/download/static/SMR_CAGE.download.txt",
      "https://www.geneasso.net/api/download/static/SMR_Geuvadis.download.txt",
      "https://www.geneasso.net/api/download/static/SMR_GTEx-top1tissue.download.txt",
      "https://www.geneasso.net/api/download/static/SMR_GTEx-top2tissue.download.txt",
      "https://www.geneasso.net/api/download/static/SMR_GTEx-top3tissue.download.txt",
      "https://www.geneasso.net/api/download/static/SMR_PsychENCODE.download.txt"
    ],
    "uncompress": false,
    "release": "version:get_release"
  }
}
