  "schema": {
    "core_fields": {
      "DAGENA": "GENEasso study ID (e.g., GA00002) — internal GWAS study identifier",
      "Reported Trait": "Original reported trait from GWAS (e.g., 'G20 Parkinson's Disease')",
      "EFO Code": "EFO or MONDO ontology code (e.g., EFO:0600011, MONDO:0001672)",
      "EFO Ontology Trait": "Standardized EFO/MONDO trait name",
      "EFO Trait Description": "Full description of the ontology term",
      "EFO Trait Synonym": "Semicolon-separated synonyms",
      "EFO Trait Tree": "Pipe-separated ontology hierarchy path",
      "Gene Symbol": "HGNC gene symbol",
      "Gene Fullname": "Full gene name",
      "Gene Biotype": "Gene type (protein_coding, lncRNA, etc.)",
      "ENSG": "Ensembl gene ID (e.g., ENSG00000145335)",
      "Gene Synonym": "Semicolon-separated gene aliases",
      "Gene Summary": "RefSeq gene description",
      "Chromosome": "Chromosome number",
      "Start Pos": "Gene start position (GRCh38)",
      "End Pos": "Gene end position (GRCh38)",
      "P-value": "Association P-value",
      "Method": "Gene-based method used (MAGMA, DEPICT, PASCAL, CWAS, RWAS, LDAK-GBAT, SMR_*)"
    },
    "method_specific_fields": {
      "MAGMA_LDAK": "N(eQTL), Z-score",
      "LDAK_GBAT": "h2 (heritability estimate)",
      "SMR": "Top1-Tissue, Top_eQTL, N(eQTL), Beta",
      "RWAS": "PEAK, MODEL, R2, Z-score"
    },
    "api_record_fields": {
      "id": "Internal numeric ID",
      "daid": "GWAS study ID (GA prefix)",
      "reportedTrait": "Original trait string",
      "efoCode": "EFO/MONDO code",
      "efoOntologyTrait": "Ontology trait name",
      "geneSymbol": "HGNC symbol",
      "geneFullname": "Full gene name",
      "geneBiotype": "Gene type",
      "ensg": "Ensembl gene ID",
      "chr": "Chromosome",
      "start": "Start position",
      "end": "End position",
      "method": "Method name",
      "pvalue": "P-value string",
      "addtionalInfo": "Method-specific additional stats (Peak, N(eQTL), Model, R2, Z-score)",
      "location": "chr:start-end formatted string",
      "population": "Available in study metadata — EUR/EAS/AFR/SAS/AMR (from per-GWAS API)"
    },
    "population_note": "Population/ancestry is stored at the GWAS study (DAGENA) level, not per-association row in bulk files. 95.34% EUR; five 1KGP super-populations supported."
  },
